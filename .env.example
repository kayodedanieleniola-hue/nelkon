# Copy these to Vercel → Project Settings → Environment Variables

# Required: Flask session signing key (app refuses to boot in production without it)
SECRET_KEY=generate_a_long_random_value

# Admin portal credentials: JSON object of username -> Werkzeug password hash.
# Generate a hash with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# The portal rejects every login while this is unset.
ADMIN_PASSWORD_HASHES={"kayode-daniel":"pbkdf2:sha256:..."}
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
POLLINATIONS_API_KEY=your_pollinations_api_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id"}
ADMIN_EMAILS=samuel@example.com,oreoluwa@example.com,kayodeeniola111@gmail.com,segun@example.com,samuel2@example.com,wonuola@example.com,marcus@example.com
AI_FREE_DAILY_MESSAGES=40
AI_DAILY_BOOST_MESSAGES=5
AI_QUOTA_DB_PATH=/tmp/nakconel_ai_quota.sqlite3

# Local development only; never enable in production
FLASK_DEBUG=0
