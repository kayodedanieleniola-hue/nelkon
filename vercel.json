{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "learning center/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/login",
      "dest": "learning center/login"
    },
    {
      "src": "/learning/(.*)",
      "dest": "learning center/learning/$1"
    },
    {
      "src": "/dashboard",
      "dest": "learning center/dashboard"
    },
    {
      "src": "/admin/(.*)",
      "dest": "learning center/admin/$1"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "learning center/api/auth/$1"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "learning center/api/admin/$1"
    },
    {
      "src": "/api/learning/(.*)",
      "dest": "learning center/api/learning/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}