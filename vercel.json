{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": ".",
      "framework": "flask",
      "entrypoint": "app:app"
    },
    "learning-center": {
      "root": "learning center",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/login", "destination": { "service": "learning-center" } },
    { "source": "/learning/(.*)", "destination": { "service": "learning-center" } },
    { "source": "/dashboard", "destination": { "service": "learning-center" } },
    { "source": "/admin/(.*)", "destination": { "service": "learning-center" } },
    { "source": "/api/auth/(.*)", "destination": { "service": "learning-center" } },
    { "source": "/api/admin/(.*)", "destination": { "service": "learning-center" } },
    { "source": "/api/learning/(.*)", "destination": { "service": "learning-center" } },
    { "source": "/(.*)", "destination": { "service": "website" } }
  ]
}
