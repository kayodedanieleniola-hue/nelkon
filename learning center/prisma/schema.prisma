// Nakconel CBT Platform — Database Schema
// Phase 1: Auth + Registration entities. More entities (Exam, Question, Attempt, etc.)
// will be added in later phases without breaking these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
  exams     Exam[]
  questions Question[]
  modules   LearningModule[]
  classes   LearningClass[]
  materials LearningMaterial[]
  assignments Assignment[]

  @@map("courses")
}

model LearningModule {
  id          String          @id @default(cuid())
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lessons     Lesson[]
  classes     LearningClass[]
  materials   LearningMaterial[]
  assignments Assignment[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("learning_modules")
}

model Lesson {
  id        String         @id @default(cuid())
  moduleId  String
  module    LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([moduleId, position])
  @@index([moduleId])
  @@map("lessons")
}

model LearningClass {
  id          String          @id @default(cuid())
  courseId    String
  moduleId    String?
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      LearningModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title       String
  instructor  String?
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      String          @default("DRAFT") // DRAFT | SCHEDULED | LIVE | COMPLETED | CANCELLED
  isGeneral         Boolean         @default(false) // true = open to all active students (General Meeting)
  activeMaterialId  String?
  presentationPage  Int?        @default(1) // current page synced to students
  recordingUrl      String?
  recordingDuration Int?        @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  materials   LearningMaterial[]
  polls       ClassPoll[]
  attendance  ClassAttendance[]
  assignments Assignment[]
  questions   ClassQuestion[]

  @@index([courseId])
  @@index([moduleId])
  @@index([courseId, startsAt])
  @@map("learning_classes")
}

model LearningMaterial {
  id          String          @id @default(cuid())
  courseId    String
  moduleId    String?
  classId     String?
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      LearningModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  learningClass LearningClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  title       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime        @default(now())

  @@index([courseId])
  @@index([moduleId])
  @@index([classId])
  @@map("learning_materials")
}

model Question {
  id           String   @id @default(cuid())
  courseId     String
  examId       String?
  course       Course   @relation(fields: [courseId], references: [id])
  exam         Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  text         String
  options      String[] // 2+ answer options, in display order
  correctIndex Int // index into `options` of the correct answer
  active       Boolean  @default(true) // inactive questions are excluded from the exam-ready count
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attemptQuestions AttemptQuestion[]

  @@index([courseId])
  @@map("questions")
}

model Exam {
  id             String    @id @default(cuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])
  name           String // e.g. "Test 1", "Final Test"
  order          Int       @default(0) // display order within the course
  numQuestions   Int
  durationMinutes Int
  passingScore   Int       @default(50) // percentage
  instructions   String?
  published      Boolean   @default(false)
  shuffleQuestions Boolean @default(true)
  shuffleOptions Boolean   @default(true)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  questions      Question[]
  attempts       ExamAttempt[]

  @@index([courseId])
  @@map("exams")
}

model Student {
  id           String   @id @default(cuid())
  studentId    String   @unique // e.g. NAK-2026-001
  fullName     String
  email        String   @unique
  phone        String
  age          Int
  gender       String
  address      String
  socialMedia  String?
  passwordHash String
  status       String   @default("active") // active | disabled
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attempts     ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  verificationPhoto      String? // small base64 JPEG data URL
  verificationDescriptor String? // JSON-encoded Float32Array
  verificationCapturedAt DateTime?

  @@index([courseId])
  @@map("students")
}

model StudentIdCounter {
  year  Int @id
  count Int @default(0)

  @@map("student_id_counters")
}

model Admin {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // room to add roles later (e.g. super_admin)
  status       String   @default("active")
  createdAt    DateTime @default(now())

  @@map("admins")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String // student | admin | system
  actorId   String?
  action    String // e.g. "student.register", "student.login", "admin.login"
  detail    String?
  ip        String?
  attemptId String?
  createdAt DateTime @default(now())

  @@index([actorType, actorId])
  @@index([attemptId])
  @@map("audit_logs")
}

model ExamAttempt {
  id           String            @id @default(cuid())
  examId       String
  studentId    String
  exam         Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       String            @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | TIMED_OUT | TERMINATED
  startedAt    DateTime          @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  score        Int?
  passed       Boolean?
  questions    AttemptQuestion[]

  activeSessionId String?
  activeSessionAt DateTime?

  pendingWarning  String?
  endedBy         String? // "student" | "timeout" | "admin:<adminId>"
  endReason       String?

  @@unique([examId, studentId])
  @@index([studentId, status])
  @@map("exam_attempts")
}

model AttemptQuestion {
  id            String      @id @default(cuid())
  attemptId     String
  questionId    String
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])
  position      Int
  text          String
  options       String[]
  correctIndex  Int
  selectedIndex Int?

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([questionId])
  @@map("attempt_questions")
}

// Learning Center Phase 11 Models — Live Polls, Attendance & Certificates
model ClassPoll {
  id          String            @id @default(cuid())
  classId     String
  learningClass LearningClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  question    String
  options     String[]
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  answers     ClassPollAnswer[]

  @@index([classId])
  @@map("class_polls")
}

model ClassPollAnswer {
  id          String    @id @default(cuid())
  pollId      String
  poll        ClassPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  studentId   String
  optionIndex Int
  createdAt   DateTime  @default(now())

  @@unique([pollId, studentId])
  @@index([pollId])
  @@map("class_poll_answers")
}

model ClassAttendance {
  id            String        @id @default(cuid())
  classId       String
  studentId     String
  learningClass LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt      DateTime      @default(now())

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@map("class_attendances")
}

model CourseCertificate {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  code       String   @unique // e.g. CERT-NAK-2026-XXXX
  issuedAt   DateTime @default(now())
  grade      String   @default("EXCELLENCE")

  @@unique([studentId, courseId])
  @@index([studentId])
  @@map("course_certificates")
}

model Assignment {
  id           String   @id @default(cuid())
  title        String
  description  String?
  instructions String?
  courseId     String
  moduleId     String?
  classId      String?
  dueDate      DateTime?
  maxScore     Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module        LearningModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  learningClass LearningClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions   AssignmentSubmission[]

  @@index([courseId])
  @@index([classId])
  @@map("assignments")
}

model AssignmentSubmission {
  id             String     @id @default(cuid())
  assignmentId   String
  studentId      String
  fileName       String?
  mimeType       String?
  sizeBytes      Int?
  fileData       Bytes?
  textSubmission String?
  submittedAt    DateTime   @default(now())
  score          Int?
  feedback       String?
  status         String     @default("SUBMITTED") // SUBMITTED | GRADED

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model ClassQuestion {
  id          String        @id @default(cuid())
  classId     String
  studentId   String
  studentName String
  question    String
  answer      String?
  answered    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  learningClass LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_questions")
}


// ── Learning Center OTP verification codes ────────────────────────────────────
// Stores short-lived codes sent to students during passwordless login.
// Keyed on email (from main Nakconel DB). Expires after 10 minutes.
model LearningOtp {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-digit numeric code, hashed with bcrypt
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("learning_otps")
}

// ── Learning Center external student profile ──────────────────────────────────
// Links a main Nakconel career_registrations record to Learning Center data.
// Created automatically on first successful login.
model LearningProfile {
  id                  String   @id @default(cuid())
  // Stable identifier from career_registrations.id in the main DB
  mainRegistrationId  String   @unique
  email               String   @unique
  fullName            String
  phone               String
  program             String
  mainStatus          String   // mirrors career_registrations.status
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
  @@map("learning_profiles")
}
